<Window x:Class="SshManager.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SshManager.ViewModels"
        xmlns:views="clr-namespace:SshManager.Views"
        Title="SSH Manager User Guide"
        Width="960" Height="720" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}">
    <Window.DataContext>
        <vm:HelpViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <views:HelpBlockTemplateSelector x:Key="HelpBlockSelector">
            <views:HelpBlockTemplateSelector.HeadingTemplate>
                <DataTemplate DataType="{x:Type vm:HelpBlockViewModel}">
                    <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,20,0,8"/>
                </DataTemplate>
            </views:HelpBlockTemplateSelector.HeadingTemplate>
            <views:HelpBlockTemplateSelector.ParagraphTemplate>
                <DataTemplate DataType="{x:Type vm:HelpBlockViewModel}">
                    <TextBlock Text="{Binding Text}" FontSize="13" LineHeight="22"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                </DataTemplate>
            </views:HelpBlockTemplateSelector.ParagraphTemplate>
            <views:HelpBlockTemplateSelector.BulletsTemplate>
                <DataTemplate DataType="{x:Type vm:HelpBlockViewModel}">
                    <ItemsControl ItemsSource="{Binding Items}" Margin="8,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" LineHeight="20"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </views:HelpBlockTemplateSelector.BulletsTemplate>
            <views:HelpBlockTemplateSelector.CodeTemplate>
                <DataTemplate DataType="{x:Type vm:HelpBlockViewModel}">
                    <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="14" Margin="0,4,0,14">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>
                </DataTemplate>
            </views:HelpBlockTemplateSelector.CodeTemplate>
            <views:HelpBlockTemplateSelector.NoteTemplate>
                <DataTemplate DataType="{x:Type vm:HelpBlockViewModel}">
                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,1,1,3"
                            Padding="14" Margin="0,4,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Text}" FontSize="12.5" LineHeight="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </views:HelpBlockTemplateSelector.NoteTemplate>
        </views:HelpBlockTemplateSelector>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}" Style="{DynamicResource SectionTitle}" FontSize="20"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0">
                    <Run Text="Bilingual guide —"/>
                    <Run Text="راهنمای دوزبانه"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="English" Width="88" Margin="0,0,6,0"
                        Command="{Binding SetEnglishCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="فارسی" Width="88"
                        Command="{Binding SetPersianCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPersian}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="12" Margin="0,16,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="Sample files:"/>
                    <Run Text="فایل‌های نمونه:" FontFamily="{DynamicResource MainFont}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="example.sshbatch" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                            Padding="12,6" Click="OpenBatchSample_Click"/>
                    <Button Content="example.sshserver" Style="{DynamicResource SecondaryButton}"
                            Padding="12,6" Click="OpenServerSample_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource BgMediumBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource BgMediumBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20,8,20,16">
                <ScrollViewer Style="{DynamicResource ModernScrollViewer}" VerticalScrollBarVisibility="Auto"
                              FlowDirection="{Binding ContentFlowDirection}">
                    <ItemsControl ItemsSource="{Binding Blocks}"
                                  ItemTemplateSelector="{StaticResource HelpBlockSelector}"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Style="{DynamicResource PrimaryButton}" Width="100" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
