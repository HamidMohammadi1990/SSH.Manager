<Window x:Class="SshManager.Views.BatchCredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Login"
        Width="480" Height="Auto"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgDarkBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Enter Credentials" Style="{DynamicResource SectionTitle}" FontSize="18"/>
            <TextBlock Text="Credentials are not read from the batch file. Enter them here to run the job securely."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="BatchSummaryText" Foreground="{DynamicResource AccentLightBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Username" Style="{DynamicResource FieldLabel}"/>
            <TextBox x:Name="UsernameBox" Style="{DynamicResource FormTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Password" Style="{DynamicResource FieldLabel}"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <PasswordBox x:Name="PasswordHiddenBox" Style="{DynamicResource FormPasswordBox}"/>
                    <TextBox x:Name="PasswordVisibleBox" Style="{DynamicResource FormTextBox}" Visibility="Collapsed"/>
                </Grid>
                <ToggleButton x:Name="RevealPasswordToggle" Grid.Column="1"
                              Style="{DynamicResource PasswordRevealToggle}"
                              Checked="RevealPasswordToggle_Changed"
                              Unchecked="RevealPasswordToggle_Changed"/>
            </Grid>

            <StackPanel x:Name="EnablePasswordPanel" Visibility="Collapsed">
                <TextBlock Text="Enable / Privilege Password" Style="{DynamicResource FieldLabel}"/>
                <TextBlock Text="Used for &lt;password&gt; steps in the batch. Leave empty to reuse the login password."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="EnablePasswordHiddenBox" Style="{DynamicResource FormPasswordBox}"/>
                        <TextBox x:Name="EnablePasswordVisibleBox" Style="{DynamicResource FormTextBox}" Visibility="Collapsed"/>
                    </Grid>
                    <ToggleButton x:Name="RevealEnablePasswordToggle" Grid.Column="1"
                                  Style="{DynamicResource PasswordRevealToggle}"
                                  Checked="RevealEnablePasswordToggle_Changed"
                                  Unchecked="RevealEnablePasswordToggle_Changed"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{DynamicResource SecondaryButton}" Width="100" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Run Batch" Style="{DynamicResource PrimaryButton}" Width="110"
                    Click="Run_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
