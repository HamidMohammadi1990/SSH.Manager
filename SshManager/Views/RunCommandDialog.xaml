<Window x:Class="SshManager.Views.RunCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run Command"
        Width="560" Height="680"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgDarkBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Run Command" Style="{DynamicResource SectionTitle}" FontSize="18"/>
            <TextBlock x:Name="PrefillHintText"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{DynamicResource ModernScrollViewer}" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Credentials" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="Username" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="UsernameBox" Style="{DynamicResource FormTextBox}" Margin="0,0,0,10"/>

                <TextBlock Text="Password" Style="{DynamicResource FieldLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="PasswordHiddenBox" Style="{DynamicResource FormPasswordBox}"/>
                        <TextBox x:Name="PasswordVisibleBox" Style="{DynamicResource FormTextBox}" Visibility="Collapsed"/>
                    </Grid>
                    <ToggleButton x:Name="RevealPasswordToggle" Grid.Column="1"
                                  Style="{DynamicResource PasswordRevealToggle}"
                                  Checked="RevealPasswordToggle_Changed"
                                  Unchecked="RevealPasswordToggle_Changed"/>
                </Grid>

                <StackPanel x:Name="EnablePasswordPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Enable / Privilege Password" Style="{DynamicResource FieldLabel}"/>
                    <TextBlock Text="Used for &lt;password&gt; in commands. Leave empty to reuse login password."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <PasswordBox x:Name="EnablePasswordHiddenBox" Style="{DynamicResource FormPasswordBox}"/>
                            <TextBox x:Name="EnablePasswordVisibleBox" Style="{DynamicResource FormTextBox}" Visibility="Collapsed"/>
                        </Grid>
                        <ToggleButton x:Name="RevealEnablePasswordToggle" Grid.Column="1"
                                      Style="{DynamicResource PasswordRevealToggle}"
                                      Checked="RevealEnablePasswordToggle_Changed"
                                      Unchecked="RevealEnablePasswordToggle_Changed"/>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Connection" Style="{DynamicResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton x:Name="TelnetRadio" GroupName="RunCommandProtocol" Content="Telnet · 23"
                                 Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                    <RadioButton x:Name="SshRadio" GroupName="RunCommandProtocol" Content="SSH · 22"
                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                </StackPanel>

                <TextBlock Text="Targets" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Text="Host IP for each device. Add or remove targets as needed."
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="TargetsList" MinHeight="100" MaxHeight="160"
                         Style="{DynamicResource FlatListBox}" Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource FormTextBox}" Margin="0,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="+ Add Target" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0"
                            Click="AddTarget_Click"/>
                    <Button Content="− Remove" Style="{DynamicResource SecondaryButton}"
                            Click="RemoveTarget_Click"/>
                </StackPanel>

                <TextBlock Text="Commands" Style="{DynamicResource SectionTitle}"/>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8">
                    One command per line. Supports &lt;Enter&gt; and &lt;password&gt; like batch @steps.
                </TextBlock>
                <TextBox x:Name="CommandsBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="140"
                         FontFamily="{DynamicResource MonoFont}"
                         FontSize="12"
                         Style="{DynamicResource FormTextBox}"
                         TextChanged="CommandsBox_TextChanged"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{DynamicResource SecondaryButton}" Width="100" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True"/>
            <Button Content="▶ Execute" Style="{DynamicResource PrimaryButton}" Width="110"
                    Click="Execute_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
